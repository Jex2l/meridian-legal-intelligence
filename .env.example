DATABASE_URL=postgresql+psycopg://lexrag:lexrag@localhost:5433/lexrag
UPLOAD_DIR=../data/uploads
OCR_TMP_DIR=../data/ocr_tmp

# LLM provider: tried in this order by get_default_provider() --
# Anthropic (paid, best quality) -> Groq (free-tier cloud) -> Ollama
# (local, zero cloud dependency). See app/generation/provider.py.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# "local" (default) loads the model in-process via sentence-transformers --
# needs torch, too much RAM for a free-tier host. "huggingface_api" calls
# HF's hosted inference API instead (needs HF_API_TOKEN). See
# app/retrieval/embedding.py and docs/DEPLOYMENT.md.
EMBEDDING_PROVIDER=local
HF_API_TOKEN=
# Cross-encoder reranking has no remote fallback -- disable it (false) on a
# RAM-constrained host; hybrid_search() falls back to the RRF fused score.
ENABLE_RERANKER=true

# Comma-separated list of allowed CORS origins for the client portal(s).
# In production, set this to your deployed frontend URL(s) -- see
# docs/DEPLOYMENT.md.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# A long random string in production -- generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
